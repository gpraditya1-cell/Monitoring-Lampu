# Frontend (Vite — artifacts/mhl)

# Port the Vite dev server listens on
PORT=5176

# Base path for the application (for Vite router)
BASE_PATH=/

# Supabase project credentials (required for authentication)
# Get these from https://supabase.com → Create project → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
